JOGOCANAL_APP_NAME=JogoCanal  # Define the application name used in FastAPI metadata
JOGOCANAL_APP_VERSION=0.1.0  # Define the application version exposed by FastAPI
JOGOCANAL_ENVIRONMENT=development  # Define whether the application is running in development, test, or production
JOGOCANAL_DEBUG=false  # Keep debug behaviour disabled unless explicitly required locally
JOGOCANAL_DATABASE_URL=sqlite+aiosqlite:///./jogocanal.db  # Define the asynchronous local database connection URL